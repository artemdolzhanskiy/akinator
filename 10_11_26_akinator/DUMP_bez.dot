digraph {
alive[shape=Mrecord]
 person[shape=Mrecord, style="filled", fillcolor="lightblue"]
  alive->person [label=" 1", style="bold", color="darkgreen"]
magic[shape=Mrecord, style="filled", fillcolor="lightblue"]
  person->magic [label=" 1", style="bold", color="darkgreen"]
man[shape=Mrecord, style="filled", fillcolor="lightblue"]
  magic->man [label=" 1", style="bold", color="darkgreen"]
he_is_electro[shape=Mrecord, style="filled", fillcolor="lightblue"]
  man->he_is_electro [label=" 1", style="bold", color="darkgreen"]
thunderer[shape=Mrecord, style="filled", fillcolor="lightblue"]
  he_is_electro->thunderer [label=" 1", style="bold", color="darkgreen"]
wizard[shape=Mrecord, style="filled", fillcolor="lightblue"]
  he_is_electro->wizard [label=" 0", style="bold", color="darkred"]
witch[shape=Mrecord, style="filled", fillcolor="lightblue"]
  man->witch [label=" 0", style="bold", color="darkred"]
close_fight[shape=Mrecord, style="filled", fillcolor="lightblue"]
  magic->close_fight [label=" 0", style="bold", color="darkred"]
knight[shape=Mrecord, style="filled", fillcolor="lightblue"]
  close_fight->knight [label=" 1", style="bold", color="darkgreen"]
hunter[shape=Mrecord, style="filled", fillcolor="lightblue"]
  close_fight->hunter [label=" 0", style="bold", color="darkred"]
fly[shape=Mrecord, style="filled", fillcolor="lightblue"]
  person->fly [label=" 0", style="bold", color="darkred"]
electro[shape=Mrecord, style="filled", fillcolor="lightblue"]
  fly->electro [label=" 1", style="bold", color="darkgreen"]
eletcrogragon[shape=Mrecord, style="filled", fillcolor="lightblue"]
  electro->eletcrogragon [label=" 1", style="bold", color="darkgreen"]
dragon[shape=Mrecord, style="filled", fillcolor="lightblue"]
  electro->dragon [label=" 0", style="bold", color="darkred"]
go_fast[shape=Mrecord, style="filled", fillcolor="lightblue"]
  fly->go_fast [label=" 0", style="bold", color="darkred"]
elite_barbarians[shape=Mrecord, style="filled", fillcolor="lightblue"]
  go_fast->elite_barbarians [label=" 1", style="bold", color="darkgreen"]
golem[shape=Mrecord, style="filled", fillcolor="lightblue"]
  go_fast->golem [label=" 0", style="bold", color="darkred"]
building_1_or_spell_0[shape=Mrecord, style="filled", fillcolor="lightblue"]
  alive->building_1_or_spell_0 [label=" 0", style="bold", color="darkred"]
spawner[shape=Mrecord, style="filled", fillcolor="lightblue"]
  building_1_or_spell_0->spawner [label=" 1", style="bold", color="darkgreen"]
gravestone[shape=Mrecord, style="filled", fillcolor="lightblue"]
  spawner->gravestone [label=" 1", style="bold", color="darkgreen"]
cannon[shape=Mrecord, style="filled", fillcolor="lightblue"]
  spawner->cannon [label=" 0", style="bold", color="darkred"]
lightwight[shape=Mrecord, style="filled", fillcolor="lightblue"]
  building_1_or_spell_0->lightwight [label=" 0", style="bold", color="darkred"]
log[shape=Mrecord, style="filled", fillcolor="lightblue"]
  lightwight->log [label=" 1", style="bold", color="darkgreen"]
rocket[shape=Mrecord, style="filled", fillcolor="lightblue"]
  lightwight->rocket [label=" 0", style="bold", color="darkred"]
}